{
  "openapi": "3.1.0",
  "info": {
    "title": "User Service API",
    "version": "0.0.0",
    "description": "Reusable user-service foundation for content-oriented web products. Public operations are namespaced under /v1."
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "user-service"
          },
          "version": {
            "type": "string",
            "example": "v1"
          },
          "now": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-10T00:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "now"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "urn:problem:not-found"
          },
          "title": {
            "type": "string",
            "example": "Not Found"
          },
          "status": {
            "type": "integer",
            "example": 404
          },
          "detail": {
            "type": "string",
            "example": "No such operation."
          },
          "code": {
            "type": "string",
            "example": "not-found"
          },
          "instance": {
            "type": "string",
            "example": "/v1/does-not-exist"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "RegisteredUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "emailVerified": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified"
        ]
      },
      "IdentityProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "urn:problem:not-found"
          },
          "title": {
            "type": "string",
            "example": "Not Found"
          },
          "status": {
            "type": "integer",
            "example": 404
          },
          "detail": {
            "type": "string",
            "example": "No such operation."
          },
          "code": {
            "type": "string",
            "example": "not-found"
          },
          "instance": {
            "type": "string",
            "example": "/v1/does-not-exist"
          },
          "failedRules": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "min-length",
                "max-length",
                "min-uppercase",
                "min-lowercase",
                "min-digits",
                "min-symbols"
              ]
            },
            "example": [
              "min-uppercase"
            ]
          },
          "passwordPolicy": {
            "type": "object",
            "properties": {
              "minLength": {
                "type": "integer"
              },
              "maxLength": {
                "type": "integer"
              },
              "minUppercase": {
                "type": "integer"
              },
              "minLowercase": {
                "type": "integer"
              },
              "minDigits": {
                "type": "integer"
              },
              "minSymbols": {
                "type": "integer"
              }
            },
            "required": [
              "minLength",
              "maxLength",
              "minUppercase",
              "minLowercase",
              "minDigits",
              "minSymbols"
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S",
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "example": "Correct-horse-41"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "emailVerified": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "example": "Correct-horse-41"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "VerifyEmailResult": {
        "type": "object",
        "properties": {
          "emailVerified": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true
          }
        },
        "required": [
          "emailVerified"
        ]
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Verification token from the action URL."
          }
        },
        "required": [
          "token"
        ]
      },
      "RequestVerificationResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "RequestVerificationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "RequestPasswordResetResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "RequestPasswordResetRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "CheckPasswordResetResult": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "valid"
        ]
      },
      "CheckPasswordResetRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Password-reset token from the action URL."
          }
        },
        "required": [
          "token"
        ]
      },
      "ResetPasswordResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Password-reset token from the action URL."
          },
          "newPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "example": "Correct-horse-41"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "emailVerified": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified"
        ]
      },
      "SignOutResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReaderState": {
        "type": "object",
        "properties": {
          "readerState": {
            "type": "string",
            "minLength": 1,
            "description": "Short-lived signed presentation-only Reader State.",
            "example": "eyJhbGciOiJFZERTQSJ9.eyJzdWIiOiJhYmMxMjMifQ.sig"
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1,
            "description": "Reader State expiry as integer Unix seconds.",
            "example": 1790000900
          }
        },
        "required": [
          "readerState",
          "expiresAt"
        ]
      },
      "ConsumerJwks": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsumerJsonWebKey"
            },
            "description": "Active and retained public verification keys."
          }
        },
        "required": [
          "keys"
        ]
      },
      "ConsumerJsonWebKey": {
        "type": "object",
        "properties": {
          "kid": {
            "type": "string",
            "minLength": 1,
            "description": "Stable durable key id.",
            "example": "abc123"
          },
          "kty": {
            "type": "string",
            "minLength": 1,
            "description": "Key type.",
            "example": "OKP"
          },
          "alg": {
            "type": "string",
            "minLength": 1,
            "description": "Fixed supported algorithm.",
            "example": "EdDSA"
          },
          "use": {
            "type": "string",
            "description": "Intended use.",
            "example": "sig"
          },
          "crv": {
            "type": "string",
            "description": "Curve name.",
            "example": "Ed25519"
          },
          "x": {
            "type": "string",
            "description": "Public x coordinate."
          },
          "y": {
            "type": "string",
            "description": "Public y coordinate."
          },
          "n": {
            "type": "string",
            "description": "Public RSA modulus."
          },
          "e": {
            "type": "string",
            "description": "Public RSA exponent."
          }
        },
        "required": [
          "kid",
          "kty",
          "alg"
        ]
      },
      "AuthConfig": {
        "type": "object",
        "properties": {
          "capabilities": {
            "$ref": "#/components/schemas/AuthCapabilities"
          },
          "passwordPolicy": {
            "$ref": "#/components/schemas/PasswordPolicy"
          }
        },
        "required": [
          "capabilities",
          "passwordPolicy"
        ]
      },
      "AuthCapabilities": {
        "type": "object",
        "properties": {
          "registration": {
            "type": "boolean"
          },
          "emailPassword": {
            "type": "boolean"
          },
          "emailVerification": {
            "type": "boolean"
          },
          "passwordReset": {
            "type": "boolean"
          }
        },
        "required": [
          "registration",
          "emailPassword",
          "emailVerification",
          "passwordReset"
        ]
      },
      "PasswordPolicy": {
        "type": "object",
        "properties": {
          "minLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "example": 8
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "example": 128
          },
          "minUppercase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128,
            "example": 1
          },
          "minLowercase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128,
            "example": 1
          },
          "minDigits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128,
            "example": 1
          },
          "minSymbols": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128,
            "example": 0
          }
        },
        "required": [
          "minLength",
          "maxLength",
          "minUppercase",
          "minLowercase",
          "minDigits",
          "minSymbols"
        ]
      },
      "AdminMe": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "emailVerified": {
            "type": "boolean",
            "example": true
          },
          "role": {
            "type": "string",
            "example": "admin"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified",
          "role"
        ]
      },
      "AdminUserList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            },
            "description": "Ascending email order."
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Matches before pagination.",
            "example": 42
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "AdminUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "emailVerified": {
            "type": "boolean",
            "example": true
          },
          "role": {
            "type": "string",
            "example": "admin"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified",
          "role"
        ]
      },
      "AdminBootstrapResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "abc123"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin"
            ],
            "example": "admin"
          },
          "emailVerified": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "emailVerified"
        ]
      },
      "AdminBootstrapRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "example": "Correct-horse-41"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service liveness",
        "description": "Lightweight liveness probe. It proves the Worker and router are running without touching D1 or any other dependency.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "The Worker is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected failure as RFC 9457 Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "operationId": "registerIdentity",
        "summary": "Register an email identity",
        "description": "Creates an unverified email/password identity when the deployment policy allows registration, and schedules a verification message through the application mail boundary. The account cannot establish a session until verification succeeds while the policy requires verified email.",
        "tags": [
          "identity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The identity was created (unverified).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredUser"
                }
              }
            }
          },
          "default": {
            "description": "Registration failure as RFC 9457 Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "loginIdentity",
        "summary": "Establish an email/password session",
        "description": "Authenticates an email/password identity. While the deployment policy requires verified email, unverified accounts receive a machine-readable verification-required failure instead of a session.",
        "tags": [
          "identity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated. The session travels in the Set-Cookie header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "default": {
            "description": "Authentication failure as RFC 9457 Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/verify-email": {
      "post": {
        "operationId": "verifyIdentityEmail",
        "summary": "Complete email verification",
        "description": "Marks the email address verified from the token delivered by the verification action. Clients extract the `token` query parameter from the action URL and submit it here. Invalid or expired actions fail safely without revealing token material.",
        "tags": [
          "identity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The email address is verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResult"
                }
              }
            }
          },
          "default": {
            "description": "Verification failure as RFC 9457 Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/request-verification": {
      "post": {
        "operationId": "requestIdentityVerification",
        "summary": "Request a verification message",
        "description": "Schedules a fresh verification message for an unverified email address without creating duplicate identities. The response is identical whether or not the address is registered, so it cannot be used for account enumeration.",
        "tags": [
          "identity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestVerificationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The request was accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestVerificationResult"
                }
              }
            }
          },
          "default": {
            "description": "Request failure as RFC 9457 Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/request-password-reset": {
      "post": {
        "operationId": "requestPasswordReset",
        "summary": "Request password recovery",
        "description": "Schedules a password-reset message for the account matching the email address without creating identities. The response is identical whether or not the address is registered, so it cannot be used for account enumeration.",
        "tags": [
          "identity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordResetRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The request was accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestPasswordResetResult"
                }
              }
            }
          },
          "default": {
            "description": "Request failure as RFC 9457 Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/check-password-reset": {
      "post": {
        "operationId": "checkPasswordReset",
        "summary": "Check a password-reset action",
        "description": "Checks whether a password-reset token is current without consuming or mutating it. Unknown, expired, and already consumed actions return `valid: false`. Responses never include token material and are never cached.",
        "tags": [
          "identity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckPasswordResetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Whether the password-reset action is current.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckPasswordResetResult"
                }
              }
            }
          },
          "default": {
            "description": "Check failure as RFC 9457 Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/reset-password": {
      "post": {
        "operationId": "resetPassword",
        "summary": "Complete password reset",
        "description": "Sets a new password from the token delivered by the password-reset action. Reset actions are single use and expire. Successful resets revoke existing sessions. Invalid, expired, reused, or malformed actions fail safely without revealing token material.",
        "tags": [
          "identity"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The password was reset.",
