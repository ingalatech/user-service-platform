{
  "name": "user-service-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "admin",
    "tools/consumer-codegen"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --env-file .env",
    "db:local:migrate": "wrangler d1 migrations apply DB --local",
    "db:local:reset": "tsx scripts/reset-local-d1.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "build:admin": "npm run build --workspace admin",
    "test:admin:browser": "tsx scripts/admin-browser-test.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && tsc --noEmit --project admin",
    "pretest": "npm run build:admin",
    "test": "vitest run",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- openapi/openapi.json",
    "consumer:generate": "tsx scripts/generate-consumer-client.ts",
    "consumer:check": "npm run consumer:generate && git diff --exit-code -- src/features/identity/consumer-client/generated/api.d.ts",
    "openapi:compat": "tsx scripts/openapi-compat.ts",
    "db:generate": "drizzle-kit generate",
    "smoke:sandbox": "tsx scripts/smoke-sandbox.ts",
    "smoke:health": "tsx scripts/smoke-health.ts",
    "smoke:readiness": "tsx scripts/smoke-readiness.ts",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "deploy": "tsx scripts/deploy.ts",
    "promote": "tsx scripts/promote.ts",
    "deploy:production": "tsx scripts/deploy.ts --env production",
    "provision": "tsx scripts/provision.ts",
    "acceptance:local": "tsx scripts/local-acceptance.ts",
    "review:safe-push": "tsx scripts/safe-push.ts",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260910.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "playwright-core": "1.64.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "wrangler": "4.130.0",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260908.1": true
  }
}
