{
  // Cloudflare Worker configuration. Local, sandbox and production are separate
  // operational contexts (ADR-0008): sandbox/production use distinct databases and
  // are never provisioned or mutated by local tests.
  //
  // This file is the local base config only. Remote deploys never use static
  // `env` sections here: `npm run deploy` (ticket #78) selects a deployment
  // target from `deploy/targets.json` and materializes a temporary
  // target-specific Wrangler config (deterministic Worker name
  // `<company>-<site>-<service>-<environment>`, isolated D1, non-secret
  // deployment vars) that is removed after the deployment. Do not reintroduce
  // generic `user-service-*` env sections: Cloudflare resources are
  // target-specific, while the application binding name stays the stable `DB`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "user-service",
  "main": "src/index.ts",
  // Must not exceed the newest compatibility date supported by the workerd
  // binary bundled with the installed test toolchain (currently 2026-08-22);
  // newer dates fail to boot under Miniflare/vitest-pool-workers.
  // `scripts/deploy/materialize.ts` mirrors this date into generated configs;
  // `deploy-materialize.test.ts` fails on drift.
  "compatibility_date": "2026-08-22",
  // Better Auth relies on AsyncLocalStorage and Node.js crypto (scrypt) for
  // password hashing; both require the Node.js compatibility flag on Workers
  // (ticket #10, ADR-0005).
  "compatibility_flags": ["nodejs_compat"],
  // Administration SPA assets (ticket #124, ADR-0012). The built client-only
  // application (`admin/dist`, produced by `npm run build:admin`) is served
  // by this same Worker origin under `/admin` through the `ASSETS` binding,
  // so browser navigation keeps the HttpOnly session cookie. The Worker owns
  // routing precedence in `src/app.ts`: `/v1/*` JSON and `/auth-actions/*`
  // keep their behavior and unknown `/v1` routes stay JSON Problem Details.
  // `scripts/deploy/materialize.ts` mirrors this entry into generated
  // target configs; `deploy-materialize.test.ts` fails on drift.
  "assets": {
    "directory": "./admin/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  // The local root `.env` is the only application configuration source for
  // local development. Remote releases materialize vars from their complete
  // `config/environments/.env.<environment>` file. Secrets (`BETTER_AUTH_SECRET`, `RESEND_API_KEY`, and
  // `SMTP_USER`/`SMTP_PASSWORD` when the SMTP transport is selected) are
  // always runtime secrets configured directly in Cloudflare for the selected
  // target Worker (see docs/operations/sandbox-release-runbook.md) and never
  // appear here.
  "vars": {
    "ENVIRONMENT": "local",
  },
  // Cloudflare-native observability baseline (ADR-0009, ticket #14): Worker
  // logs, traces and platform metrics are enabled for every environment.
  // Application logs stay structured/correlated with request ids and never
  // carry credentials, tokens, cookies, action URLs or message bodies.
  "observability": {
    "enabled": true,
  },
  // D1 binding/configuration seam for isolated local tests (ticket #9). No business
  // persistence abstractions are introduced here; the identity slice owns its
  // Drizzle schema and versioned migrations under `./drizzle` (ticket #10).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "user-service-local",
      "database_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "migrations_dir": "drizzle",
    },
  ],
}
